{
  "schema_version": 2,
  "project_name": "my-project",
  "jira_project_key": null,
  "jira_integration": false,
  "jira_subtask_type": "Subtask",
  "jira_transitions": {
    "staging": "In Review",
    "prod": "Done"
  },
  "slack_mcp_channel": null,
  "slack_integration": false,
  "build_command": "echo '[ship] Configure build_command in .claude/framework.json'",
  "test_command": "python -m pytest . -v --tb=short",
  "lint_command": "python -m ruff check --fix {file}",
  "typecheck_command": "python -m mypy {file} --ignore-missing-imports --no-error-summary",
  "project_typecheck_command": "python -m mypy . --ignore-missing-imports",
  "gate_extensions": [
    ".py"
  ],
  "approval_gate": true,
  "work_item_gate": true,
  "adr_path": "docs/adr",
  "autopilot": "suggest",
  "structure_gate": true,
  "fitness_gate": true,
  "layout_extra_dirs": [],
  "lld_path": "docs/lld",
  "notes_path": "docs/design-notes",
  "review_path": "docs/reviews",
  "design_readiness_gate": true,
  "budget_alert_threshold": 95,
  "sdd_path": "docs/sdd",
  "memory_path": null,
  "languages": [
    "python"
  ],
  "reconcile": true,
  "reconcile_edit_threshold": 5,
  "impl_doc_path": "docs/implementation",
  "reconcile_docs": []
}
